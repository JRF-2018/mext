@mext 1
theory: sublease.matcha
; MEXT: Matcha EXTension notation（本レポートの考案）。書式は docs/mext.md を参照。

[ai]
; AI（または人）の判断。各行の ; 以降に理由を書く。
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2

[claimed]
; （検証したい Extension を 名前[*]: "文言", -"文言", ... の形で書く。* は preferred）

; ===== ここから下は mext.py が自動生成（手で直さない） =====
[atoms]
k1     claim  "#解除^民法612条2項 [無断転貸解除]"  ; L2
f1     fact   "本件賃貸借"  ; L2,L8,L12
r1     req    "無断転貸解除／「賃借人が賃借物について権利を譲り渡し、又は賃借物を転貸」"  ; L3
f2     fact   "乙は丙に本件建物を転貸した"  ; L3
r2     req    "無断転貸解除／「第三者に賃借物の使用又は収益をさせた」"  ; L4
f3     fact   "丙は本件建物で営業している"  ; L4
r3     req    "無断転貸解除／%解除の意思表示"  ; L5
f4     fact   "甲は乙に解除を通知した"  ; L5
x1     aux    "（L2 の AND・3項・1）"  ; L2
c1     concl  "甲は本件賃貸借を解除できる〔本件賃貸借〕"  ; L6,L10,L14
k2     claim  "#承諾の抗弁^民法612条1項 [承諾]"  ; L8
r4     req    "承諾／「賃貸人の承諾」"  ; L9
f5     fact   "甲は転貸を口頭で承諾した"  ; L9
k3     claim  "#非背信性の抗弁^最判昭和28年9月25日民集7巻9号979頁 [非背信性]"  ; L12
q1     issue  "非背信性／? 無断転貸でも解除できない場合"  ; L13
r5     req    "非背信性／%賃貸人に対する背信的行為と認めるに足りない特段の事情"  ; L13
f6     fact   "丙は乙の同居の親族で使用状況は従前と変わらない"  ; L13
v1     eval   "丙は乙の同居の親族で使用状況は従前と変わらない@信頼関係は破壊されていない"  ; L13
ab1    ab     "ab(無断転貸解除)"

[W]
f1, f2, f3, f4, f5, f6

[rules]
r1: f2 -> r1  ; L3 「賃借人が賃借物について権利を譲り渡し、又は賃借物を転貸」
r2: -f2 -> -r1  ; L3 「賃借人が賃借物について権利を譲り渡し、又は賃借物を転貸」（必要条件の否定）
r3: f3 -> r2  ; L4 「第三者に賃借物の使用又は収益をさせた」
r4: -f3 -> -r2  ; L4 「第三者に賃借物の使用又は収益をさせた」（必要条件の否定）
r5: f4 -> r3  ; L5 %解除の意思表示
r6: -f4 -> -r3  ; L5 %解除の意思表示（必要条件の否定）
r7: r1 & r2 & r3 -> x1  ; AND
r8: -r1 -> -x1  ; AND（必要条件の否定）
r9: -r2 -> -x1  ; AND（必要条件の否定）
r10: -r3 -> -x1  ; AND（必要条件の否定）
r11: -x1 -> -k1  ; L2 要件の否定による主張 無断転貸解除 の不成立
r12: f5 -> r4  ; L9 「賃貸人の承諾」
r13: -f5 -> -r4  ; L9 「賃貸人の承諾」（必要条件の否定）
r14: -r4 -> -k2  ; L8 要件の否定による主張 承諾 の不成立
r15: v1 -> r5  ; L13 %賃貸人に対する背信的行為と認めるに足りない特段の事情
r16: -v1 -> -r5  ; L13 %賃貸人に対する背信的行為と認めるに足りない特段の事情（必要条件の否定）
r17: r5 -> q1  ; L13 論点「無断転貸でも解除できない場合」
r18: -r5 -> -q1  ; L13 論点「無断転貸でも解除できない場合」（必要条件の否定）
r19: -q1 -> -k3  ; L12 要件の否定による主張 非背信性 の不成立

[defaults]
無断転貸解除: f1, x1 : k1, c1, -ab1 / k1, c1  ; claim L2 主張 ^民法612条2項
承諾: f1, r4 : k2, -c1 / k2, -c1, ab1  ; claim L8 主張 ^民法612条1項
e1: f6 : v1, r5 / v1  ; eval L13 評価 @信頼関係は破壊されていない
非背信性: f1, q1 : k3, -c1 / k3, -c1, ab1  ; claim L12 主張 ^最判昭和28年9月25日民集7巻9号979頁

[priority]
承諾 > 無断転貸解除
非背信性 > 無断転貸解除

[extensions]
; 衝突しうるデフォルト: 無断転貸解除, 承諾, 非背信性
E1:
  generating: 無断転貸解除, e1
  literals: k1, f1, r1, f2, r2, f3, r3, f4, x1, c1, r4, f5, q1, r5, f6, v1
E2 preferred:
  generating: 承諾, e1, 非背信性
  literals: f1, r1, f2, r2, f3, r3, f4, x1, -c1, k2, r4, f5, k3, q1, r5, f6, v1, ab1

[marks]

[summary]
extensions: 2 (preferred: 1)
skeptical: -c1, k2, k3
credulous: -c1, k2, k3
