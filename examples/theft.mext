@mext 1
theory: theft.matcha
; MEXT: Matcha EXTension notation（本レポートの考案）。書式は docs/mext.md を参照。

[ai]
; AI（または人）の判断。各行の ; 以降に理由を書く。
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2

[claimed]
; （検証したい Extension を 名前[*]: "文言", -"文言", ... の形で書く。* は preferred）

; ===== ここから下は mext.py が自動生成（手で直さない） =====
[atoms]
k1     claim  "#窃盗罪^235条"  ; L2
f1     fact   "甲が本件財布を持ち去った行為"  ; L2
r1     req    "窃盗罪／「他人の財物」"  ; L3
r2     req    "窃盗罪／%他人が所有する財産的価値のある有体物"  ; L3
f2     fact   "本件財布はAが所有する"  ; L3
r3     req    "窃盗罪／「窃取」"  ; L4
r4     req    "窃盗罪／%占有者の意思に反して占有を自己又は第三者に移転すること"  ; L4
r5     req    "窃盗罪／%占有者の意思に反して"  ; L5
f3     fact   "A"  ; L5
v1     eval   "A@占有者"  ; L5
r6     req    "窃盗罪／%占有"  ; L6
r7     req    "窃盗罪／%人が物を実力的に支配する関係"  ; L6
f4     fact   "公園のベンチにおいていた"  ; L7
f5     fact   "最大20メートル離れて5分後に取りに戻った"  ; L7
x1     aux    "（L7 の AND・2項・1）"  ; L7
v2     eval   "（L7 の事実群）@Aが財布を実力的に支配している"  ; L7
r8     req    "窃盗罪／%自己又は第三者に移転"  ; L9
f6     fact   "甲"  ; L10
v3     eval   "甲@自己"  ; L10
f7     fact   "持ち去った"  ; L11,L16
v4     eval   "持ち去った@移転"  ; L11
x2     aux    "（L9 の AND・2項・1）"  ; L9
x3     aux    "（L4 の AND・3項・1）"  ; L4
r9     req    "窃盗罪／%故意"  ; L14
r10    req    "窃盗罪／%事実の認識・認容"  ; L14
f8     fact   "甲は前記事実を認識認容している"  ; L14
q1     issue  "窃盗罪／? 財産犯と不可罰的な使用窃盗及び遺棄・隠匿罪との区別する必要がある"  ; L15
r11    req    "窃盗罪／%不法領得の意思"  ; L15
r12    req    "窃盗罪／%権利者を排除して他人の物を自己の所有物とし"  ; L16
v5     eval   "持ち去った@権利者Aを排除して"  ; L16
r13    req    "窃盗罪／%経済的用法に従って利用処分する意思"  ; L17
f9     fact   "金銭を得る目的だった"  ; L17
v6     eval   "金銭を得る目的だった@財布そのものから効用を得る"  ; L17
x4     aux    "（L15 の AND・2項・1）"  ; L15
x5     aux    "（L2 の AND・4項・1）"  ; L2
c1     concl  "甲に窃盗罪が成立する〔甲が本件財布を持ち去った行為〕"  ; L20

[W]
f1, f2, f3, f4, f5, f6, f7, f8, f9

[rules]
r1: f2 -> r2  ; L3 %他人が所有する財産的価値のある有体物
r2: -f2 -> -r2  ; L3 %他人が所有する財産的価値のある有体物（必要条件の否定）
r3: r2 -> r1  ; L3 「他人の財物」
r4: -r2 -> -r1  ; L3 「他人の財物」（必要条件の否定）
r5: v1 -> r5  ; L5 %占有者の意思に反して
r6: -v1 -> -r5  ; L5 %占有者の意思に反して（必要条件の否定）
r7: f4 & f5 -> x1  ; AND
r8: -f4 -> -x1  ; AND（必要条件の否定）
r9: -f5 -> -x1  ; AND（必要条件の否定）
r10: v2 -> r7  ; L6 %人が物を実力的に支配する関係
r11: -v2 -> -r7  ; L6 %人が物を実力的に支配する関係（必要条件の否定）
r12: r7 -> r6  ; L6 %占有
r13: -r7 -> -r6  ; L6 %占有（必要条件の否定）
r14: v3 & v4 -> x2  ; AND
r15: -v3 -> -x2  ; AND（必要条件の否定）
r16: -v4 -> -x2  ; AND（必要条件の否定）
r17: x2 -> r8  ; L9 %自己又は第三者に移転
r18: -x2 -> -r8  ; L9 %自己又は第三者に移転（必要条件の否定）
r19: r5 & r6 & r8 -> x3  ; AND
r20: -r5 -> -x3  ; AND（必要条件の否定）
r21: -r6 -> -x3  ; AND（必要条件の否定）
r22: -r8 -> -x3  ; AND（必要条件の否定）
r23: x3 -> r4  ; L4 %占有者の意思に反して占有を自己又は第三者に移転すること
r24: -x3 -> -r4  ; L4 %占有者の意思に反して占有を自己又は第三者に移転すること（必要条件の否定）
r25: r4 -> r3  ; L4 「窃取」
r26: -r4 -> -r3  ; L4 「窃取」（必要条件の否定）
r27: f8 -> r10  ; L14 %事実の認識・認容
r28: -f8 -> -r10  ; L14 %事実の認識・認容（必要条件の否定）
r29: r10 -> r9  ; L14 %故意 ^38条1項本文
r30: -r10 -> -r9  ; L14 %故意 ^38条1項本文（必要条件の否定）
r31: v5 -> r12  ; L16 %権利者を排除して他人の物を自己の所有物とし
r32: -v5 -> -r12  ; L16 %権利者を排除して他人の物を自己の所有物とし（必要条件の否定）
r33: v6 -> r13  ; L17 %経済的用法に従って利用処分する意思
r34: -v6 -> -r13  ; L17 %経済的用法に従って利用処分する意思（必要条件の否定）
r35: r12 & r13 -> x4  ; AND
r36: -r12 -> -x4  ; AND（必要条件の否定）
r37: -r13 -> -x4  ; AND（必要条件の否定）
r38: x4 -> r11  ; L15 %不法領得の意思
r39: -x4 -> -r11  ; L15 %不法領得の意思（必要条件の否定）
r40: r11 -> q1  ; L15 論点「財産犯と不可罰的な使用窃盗及び遺棄・隠匿罪との区別する必要がある」
r41: -r11 -> -q1  ; L15 論点「財産犯と不可罰的な使用窃盗及び遺棄・隠匿罪との区別する必要がある」（必要条件の否定）
r42: r1 & r3 & r9 & q1 -> x5  ; AND
r43: -r1 -> -x5  ; AND（必要条件の否定）
r44: -r3 -> -x5  ; AND（必要条件の否定）
r45: -r9 -> -x5  ; AND（必要条件の否定）
r46: -q1 -> -x5  ; AND（必要条件の否定）
r47: -x5 -> -k1  ; L2 要件の否定による主張 L2 の不成立

[defaults]
e1: f3 : v1, r5 / v1  ; eval L5 評価 @占有者
e2: x1 : v2, r7 / v2  ; eval L7 評価 @Aが財布を実力的に支配している
e3: f6 : v3, r8 / v3  ; eval L10 評価 @自己
e4: f7 : v4, r8 / v4  ; eval L11 評価 @移転
e5: f7 : v5, r12 / v5  ; eval L16 評価 @権利者Aを排除して
e6: f9 : v6, r13 / v6  ; eval L17 評価 @財布そのものから効用を得る
L2: f1, x5 : k1, c1 / k1, c1  ; claim L2 主張 ^235条

[priority]

[extensions]
; 衝突しうるデフォルト: なし
E1 preferred:
  generating: e1, e2, e3, e4, e5, e6, L2
  literals: k1, f1, r1, r2, f2, r3, r4, r5, f3, v1, r6, r7, f4, f5, x1, v2, r8, f6, v3, f7, v4, x2, x3, r9, r10, f8, q1, r11, r12, v5, r13, f9, v6, x4, x5, c1

[marks]

[summary]
extensions: 1 (preferred: 1)
skeptical: k1, c1
credulous: k1, c1
