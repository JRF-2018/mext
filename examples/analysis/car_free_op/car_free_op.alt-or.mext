[ai]
; judgments by the AI (or a person). Write the reason after ; on each line.
;   same "representative" "same meaning"
;   neg  "A" "B"                 … B is the negation of A
;   failure "text" / effect "text" … read a conclusion as a consequence of failure / an effect
;   review "fact@evaluation" ok|doubtful|reject
;   concern name "premise" "premise" … premises sharing one point of contention
;   distinct "premise" "premise" …   … premises independent of each other
;   connective "claim label or requirement" explicit|reading … whether AND/OR is explicit in the source
;   fact-kind "fact" description|assumption|verified|author-claim … kind of a fact in W
;   supplied "premise" …             … premise supplied by the transcriber (not in the source)

[extra]
;   fact "text" / rule "a" & "b" -> "c" / default name: "a" : "b" / "b" / priority name1 > name2

[claimed]
;   E1*: "text", -"text"   … an Extension to verify (* also claims it is preferred)

