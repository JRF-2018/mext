c5     concl  "the disability concern is an argument for exceptions, not against the plan〔downtown core〕"  ; L45
k7     claim  "#Car-free downtown plan [plan]"  ; L49
r8     req    "plan／$safety"  ; L50
r9     req    "plan／$business"  ; L51
r10    req    "plan／$air"  ; L52
x3     aux    "（L49 の AND・3項・1）"  ; L49
ab1    ab     "ab(disability)"

[W]
f1, f2, f3, f4, f5, f6, f7, f8, f9, f10

[rules]
r1: f2 & f3 -> x1  ; AND
r2: -f2 -> -x1  ; AND（必要条件の否定）
r3: -f3 -> -x1  ; AND（必要条件の否定）
r4: v1 -> r1  ; L9 %private cars are the main source of danger to pedestrians downtown
r5: -v1 -> -r1  ; L9 %private cars are the main source of danger to pedestrians downtown（必要条件の否定）
r6: -r1 -> -k1  ; L7 要件の否定による主張 safety の不成立
r7: v2 -> r2  ; L14 %customers who drive will stop coming
r8: -v2 -> -r2  ; L14 %customers who drive will stop coming（必要条件の否定）
r9: -r2 -> -k2  ; L13 要件の否定による主張 fear の不成立
r10: v3 -> r3  ; L20 %local shops would not lose sales without customers who drive
r11: -v3 -> -r3  ; L20 %local shops would not lose sales without customers who drive（必要条件の否定）
r12: -r3 -> -k3  ; L18 要件の否定による主張 business の不成立
r13: v4 -> r4  ; L29 %air quality downtown needs to be improved
r14: -v4 -> -r4  ; L29 %air quality downtown needs to be improved（必要条件の否定）
r15: v5 -> r5  ; L32 %removing private cars would cut nitrogen dioxide downtown substantially
r16: -v5 -> -r5  ; L32 %removing private cars would cut nitrogen dioxide downtown substantially（必要条件の否定）
r17: r4 & r5 -> x2  ; AND
r18: -r4 -> -x2  ; AND（必要条件の否定）
r19: -r5 -> -x2  ; AND（必要条件の否定）
r20: -x2 -> -k4  ; L27 要件の否定による主張 air の不成立
r21: f9 -> r6  ; L39 %people with disabilities depend on cars
r22: -f9 -> -r6  ; L39 %people with disabilities depend on cars（必要条件の否定）
r23: -r6 -> -k5  ; L38 要件の否定による主張 disability の不成立
r24: v6 -> r7  ; L44 %the concern can be met by exceptions to the plan
r25: -v6 -> -r7  ; L44 %the concern can be met by exceptions to the plan（必要条件の否定）
r26: -r7 -> -k6  ; L43 要件の否定による主張 exceptions の不成立
r27: r8 & r9 & r10 -> x3  ; AND
r28: -r8 -> -x3  ; AND（必要条件の否定）
r29: -r9 -> -x3  ; AND（必要条件の否定）
r30: -r10 -> -x3  ; AND（必要条件の否定）
r31: -x3 -> -k7  ; L49 要件の否定による主張 plan の不成立
r32: k1 -> r8  ; L50 $safety の参照
r33: -k1 -> -r8  ; L50 $safety の参照（必要条件の否定）
r34: k3 -> r9  ; L51 $business の参照
r35: -k3 -> -r9  ; L51 $business の参照（必要条件の否定）
r36: k4 -> r10  ; L52 $air の参照
r37: -k4 -> -r10  ; L52 $air の参照（必要条件の否定）

[defaults]
e1: x1 : v1, r1 / v1  ; eval L9 評価 @the involvement of private cars in nearly all of the injuries shows that the cars cause the danger
safety: f1, r1 : k1, c1 / k1, c1  ; claim L7 主張
e2: f5 : v2, r2 / v2  ; eval L14 評価 @the shop owners' fear is well founded
fear: f4, r2 : k2, c2 / k2, c2  ; claim L13 主張
e3: f6 : v3, r3 / v3  ; eval L20 評価 @the survey results from other cities hold in our city and lost driving customers would be made up by pedestrian customers（AI: 疑わしい）
business: f4, r3 : k3, -c2 / k3, -c2  ; claim L18 主張
e4: f7 : v4, r4 / v4  ; eval L29 評価 @exceeding the national guideline shows a problem that calls for action
e5: f8 : v5, r5 / v5  ; eval L32 評価 @private cars make up most of that traffic（AI: 疑わしい）
air: f1, x2 : k4, c3 / k4, c3  ; claim L27 主張
disability: f1, r6 : k5, -c4, -ab1 / k5, -c4  ; claim L38 主張
e6: f10 : v6, r7 / v6  ; eval L44 評価 @permits for disabled drivers would meet the needs of people with disabilities（AI: 疑わしい）
exceptions: f1, r7 : k6, c5 / k6, c5, ab1  ; claim L43 主張
plan: f1, x3 : k7, c4 / k7, c4  ; claim L49 主張

[priority]
business > fear
exceptions > disability

[extensions]
; 衝突しうるデフォルト: fear, business, disability, plan
E1:
  generating: e1, safety, e2, fear, e3, e4, e5, air, e6, exceptions
  literals: k1, f1, r1, f2, f3, x1, v1, c1, k2, f4, r2, f5, v2, c2, r3, f6, v3, k4, r4, f7, v4, r5, f8, v5, x2, c3, r6, f9, k6, r7, f10, v6, c5, r8, r10, ab1
E2 preferred:
  generating: e1, safety, e2, e3, business, e4, e5, air, e6, exceptions, plan
  literals: k1, f1, r1, f2, f3, x1, v1, c1, f4, r2, f5, v2, -c2, k3, r3, f6, v3, k4, r4, f7, v4, r5, f8, v5, x2, c3, r6, f9, c4, k6, r7, f10, v6, c5, k7, r8, r9, r10, x3, ab1

[marks]

[summary]
extensions: 2 (preferred: 1)
skeptical: k1, c1, -c2, k3, k4, c3, c4, k6, c5, k7
credulous: k1, c1, -c2, k3, k4, c3, c4, k6, c5, k7
; 検証の範囲: 評価 6 個（未審査 0・ok 3・doubtful 3・reject 0。doubtful と未審査の評価も推論を止めない）。W の事実 8 個（記述 7・著者の主張 1。種別は AI の判断。仮定と著者の主張は感度分析で外す候補にする）。最終的な結論 4 個のうち、成り立つもの 2 個、理論の中に対立する命題（否定）がないもの 1 個（これらは、反対の根拠に勝ったのではなく、反対の根拠が書かれていないだけである）。
