@mext 1
theory: yatoidome_memo.matcha
; MEXT: Matcha EXTension notation。書式は mext の docs/mext.md（スキルでは references/mext.md）を参照。

[ai]
; AI（または人）の判断。各行の ; 以降に理由を書く。
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject
; same / neg / failure / effect: なし。同じ命題を違う文言で書いた原子は見当たらない（c1 と r1、c3 と r3 は意味が近いが、結論と要件の関係にあり、$参照で結んであるので同一視は不要）。
review "（更新は4回に及び通算期間は5年近い & Xの業務は正社員と同じで臨時的なものではない & 更新手続きは形式的で更新するかどうかを個別に審査した形跡がない & センター長は採用時にまじめにやっていればずっと働いてもらえると述べた）@これらを総合すればXが更新を期待したのは当然である" ok  ; 更新回数・通算期間・業務の恒常性・手続の形式性・使用者の言動という、期待の合理性を判断する通常の要素がすべて同じ向きを指している。ただし評価の文言は「期待したのは当然」と主観寄りで、要件（期待に合理的な理由がある）とのずれは言葉の上のものにとどまる。センター長の発言は条件付き（まじめにやっていれば）で、5年前の採用時のものである点は弱い
review "契約書に更新の有無は業務量・経営状況により判断すると書いてある@この条項は定型的な書式にすぎず実際の更新の運用とセンター長の発言に照らせばXの期待を打ち消すものではない" reject  ; 【試算】条項が定型的な書式にすぎないという評価が退けられた場合。元の審査の理由: 条項が「定型的な書式にすぎない」ことは文書に事実として示されていない（X が毎回この条項のある書面に署名した、とも読める）。条項は期待を弱める事情として考慮されうるので、打ち消さないとまで言えるかは争いうる。期待の評価と同じ事実（運用・発言）を使っているので、独立の根拠ではない
review "Xは雇止めの撤回を求めている@雇止めの撤回を求めていることは更新の申込みにあたる" ok  ; 雇止めに異議を述べることを更新の申込みと見るのは一般的な理解に沿う。ただし申込みの時期（満了前か、満了後遅滞なくか）は文書に書かれていない（§8 で扱う）
review "（Y社自身の経営は黒字で削減は親会社の方針にすぎない & Y社は削減の対象者を選ぶ基準を示していない & Xと同じセンターで働く他の契約社員の中には更新された者もいる & 希望退職の募集や配置転換といった雇止めを避けるための努力をした形跡がない）@雇止めは客観的に合理的な理由を欠く" doubtful  ; (1)「黒字」「親会社の方針にすぎない」は Y社単体の話で、グループとしての削減の必要性を否定しない。(2) 有期の契約社員の雇止めでは、正社員の希望退職募集を先に行う必要はないとした判例（日立メディコ事件・最一小判昭和61年12月4日。AI の背景知識で、文書は引いていない）があり、「回避努力の形跡がない」の重みは正社員の解雇より軽くなりうる。(3) 他の契約社員が更新されたことは、選別の基準がないことの裏づけにも、必要な人員だけを残したことの裏づけにもなる。結論はありうるが、反対の評価も十分ありうる
review "（Y社自身の経営は黒字で削減は親会社の方針にすぎない & Y社は削減の対象者を選ぶ基準を示していない & Xと同じセンターで働く他の契約社員の中には更新された者もいる & 希望退職の募集や配置転換といった雇止めを避けるための努力をした形跡がない）@雇止めは社会通念上相当であるとは認められない" doubtful  ; 合理性と同じ事実の組をそのまま相当性にも使っている。相当性に固有の事情（説明・協議の経過、通知の時期、代償措置の有無など）は文書に一つもない。結論はありうるが、独立の根拠を欠く
review "Y社は親会社の方針で物流部門の人件費を一割削減するためとして雇止めをした@経営上の理由による人員の削減にあたる" ok  ; 人件費削減のための雇止めは、文字どおり経営上の理由による人員の削減である（文書自身もそれを認めたうえで、本件の事情で退けている）

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2
default 条項の評価: "契約書に更新の有無は業務量・経営状況により判断すると書いてある" : "条項反論／「Xは更新を当然に期待できなかった」" / "条項反論／「Xは更新を当然に期待できなかった」"  ; 【試算】Y社の評価（条項によって X は更新を当然に期待できなかった）が認められた場合

[claimed]
T1*: "#契約書の更新条項による反論^契約書の更新条項 [条項反論]", !"Xには更新を期待する合理的な理由がある", !"Y社はXの更新の申込みを従前と同じ条件で承諾したものとみなされる", "本件雇止めは客観的に合理的な理由を欠き社会通念上相当であるとは認められない"  ; 試算の予測: 条項反論が働き、!> により期待が阻却される。理由欠如は残るが、承諾みなしには至らない

; ===== ここから下は mext.py が自動生成（手で直さない） =====
[atoms]
k1     claim  "#更新への合理的な期待^労働契約法19条2号 [期待]"  ; L6
f1     fact   "X"  ; L6,L21,L28
r1     req    "期待／「契約の更新を期待することに合理的な理由がある」"  ; L8
f2     fact   "更新は4回に及び通算期間は5年近い"  ; L10
f3     fact   "Xの業務は正社員と同じで臨時的なものではない"  ; L12
f4     fact   "更新手続きは形式的で更新するかどうかを個別に審査した形跡がない"  ; L14
f5     fact   "センター長は採用時にまじめにやっていればずっと働いてもらえると述べた"  ; L16
x1     aux    "（L8 の AND・4項・1）"  ; L8
v1     eval   "（更新は4回に及び通算期間は5年近い & Xの業務は正社員と同じで臨時的なものではない & 更新手続きは形式的で更新するかどうかを個別に審査した形跡がない & センター長は採用時にまじめにやっていればずっと働いてもらえると述べた）@これらを総合すればXが更新を期待したのは当然である"  ; L8
c1     concl  "Xには更新を期待する合理的な理由がある〔X〕"  ; L18
k2     claim  "#契約書の更新条項による反論^契約書の更新条項 [条項反論]"  ; L21
r2     req    "条項反論／「Xは更新を当然に期待できなかった」"  ; L23
f6     fact   "契約書に更新の有無は業務量・経営状況により判断すると書いてある"  ; L23
v2     eval   "契約書に更新の有無は業務量・経営状況により判断すると書いてある@この条項は定型的な書式にすぎず実際の更新の運用とセンター長の発言に照らせばXの期待を打ち消すものではない"  ; L23
c2     concl  "契約書の条項はXの期待を打ち消さない〔X〕"  ; L24
k3     claim  "#更新の申込み^労働契約法19条 [申込み]"  ; L28
r3     req    "申込み／「契約の更新の申込みをした」"  ; L29
f7     fact   "Xは雇止めの撤回を求めている"  ; L29
v3     eval   "Xは雇止めの撤回を求めている@雇止めの撤回を求めていることは更新の申込みにあたる"  ; L29
c3     concl  "Xは更新の申込みをしている〔X〕"  ; L30
k4     claim  "#合理性と相当性の欠如^労働契約法19条 [理由欠如]"  ; L35
f8     fact   "本件雇止め"  ; L35,L55
r4     req    "理由欠如／「客観的に合理的な理由を欠き」"  ; L36
f9     fact   "Y社自身の経営は黒字で削減は親会社の方針にすぎない"  ; L38,L47
f10    fact   "Y社は削減の対象者を選ぶ基準を示していない"  ; L40,L48
f11    fact   "Xと同じセンターで働く他の契約社員の中には更新された者もいる"  ; L42,L49
f12    fact   "希望退職の募集や配置転換といった雇止めを避けるための努力をした形跡がない"  ; L44,L50
x2     aux    "（L36 の AND・4項・1）"  ; L36
v4     eval   "（Y社自身の経営は黒字で削減は親会社の方針にすぎない & Y社は削減の対象者を選ぶ基準を示していない & Xと同じセンターで働く他の契約社員の中には更新された者もいる & 希望退職の募集や配置転換といった雇止めを避けるための努力をした形跡がない）@雇止めは客観的に合理的な理由を欠く"  ; L36
r5     req    "理由欠如／「社会通念上相当であると認められない」"  ; L46
x3     aux    "（L46 の AND・4項・1）"  ; L46
v5     eval   "（Y社自身の経営は黒字で削減は親会社の方針にすぎない & Y社は削減の対象者を選ぶ基準を示していない & Xと同じセンターで働く他の契約社員の中には更新された者もいる & 希望退職の募集や配置転換といった雇止めを避けるための努力をした形跡がない）@雇止めは社会通念上相当であるとは認められない"  ; L46
x4     aux    "（L35 の AND・2項・1）"  ; L35
c4     concl  "本件雇止めは客観的に合理的な理由を欠き社会通念上相当であるとは認められない〔本件雇止め〕"  ; L52,L58
k5     claim  "#経営上の理由による雇止め^経営上の理由による人員の削減は雇止めの合理的な理由になりうる [経営理由]"  ; L55
r6     req    "経営理由／「経営上の理由による人員の削減」"  ; L57
f13    fact   "Y社は親会社の方針で物流部門の人件費を一割削減するためとして雇止めをした"  ; L57
v6     eval   "Y社は親会社の方針で物流部門の人件費を一割削減するためとして雇止めをした@経営上の理由による人員の削減にあたる"  ; L57
k6     claim  "#更新の承諾みなし^労働契約法19条 [承諾みなし]"  ; L66
f14    fact   "Xの更新の申込み"  ; L66
r7     req    "承諾みなし／$期待"  ; L67
r8     req    "承諾みなし／$申込み"  ; L68
r9     req    "承諾みなし／$理由欠如"  ; L69
x5     aux    "（L66 の AND・3項・1）"  ; L66
c5     concl  "Y社はXの更新の申込みを従前と同じ条件で承諾したものとみなされる〔Xの更新の申込み〕"  ; L70
ab1    ab     "ab(期待)"

[W]
f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14

[rules]
r1: f2 & f3 & f4 & f5 -> x1  ; AND
r2: -f2 -> -x1  ; AND（必要条件の否定）
r3: -f3 -> -x1  ; AND（必要条件の否定）
r4: -f4 -> -x1  ; AND（必要条件の否定）
r5: -f5 -> -x1  ; AND（必要条件の否定）
r6: v1 -> r1  ; L8 「契約の更新を期待することに合理的な理由がある」
r7: -v1 -> -r1  ; L8 「契約の更新を期待することに合理的な理由がある」（必要条件の否定）
r8: -r1 -> -k1  ; L6 要件の否定による主張 期待 の不成立
r9: v2 -> -r2  ; L23 「Xは更新を当然に期待できなかった」（不成立の根拠）
r10: -r2 -> -k2  ; L21 要件の否定による主張 条項反論 の不成立
r11: v3 -> r3  ; L29 「契約の更新の申込みをした」
r12: -v3 -> -r3  ; L29 「契約の更新の申込みをした」（必要条件の否定）
r13: -r3 -> -k3  ; L28 要件の否定による主張 申込み の不成立
r14: f9 & f10 & f11 & f12 -> x2  ; AND
r15: -f9 -> -x2  ; AND（必要条件の否定）
r16: -f10 -> -x2  ; AND（必要条件の否定）
r17: -f11 -> -x2  ; AND（必要条件の否定）
r18: -f12 -> -x2  ; AND（必要条件の否定）
r19: v4 -> r4  ; L36 「客観的に合理的な理由を欠き」
r20: -v4 -> -r4  ; L36 「客観的に合理的な理由を欠き」（必要条件の否定）
r21: f9 & f10 & f11 & f12 -> x3  ; AND
r22: -f9 -> -x3  ; AND（必要条件の否定）
r23: -f10 -> -x3  ; AND（必要条件の否定）
r24: -f11 -> -x3  ; AND（必要条件の否定）
r25: -f12 -> -x3  ; AND（必要条件の否定）
r26: v5 -> r5  ; L46 「社会通念上相当であると認められない」
r27: -v5 -> -r5  ; L46 「社会通念上相当であると認められない」（必要条件の否定）
r28: r4 & r5 -> x4  ; AND
r29: -r4 -> -x4  ; AND（必要条件の否定）
r30: -r5 -> -x4  ; AND（必要条件の否定）
r31: -x4 -> -k4  ; L35 要件の否定による主張 理由欠如 の不成立
r32: v6 -> r6  ; L57 「経営上の理由による人員の削減」
r33: -v6 -> -r6  ; L57 「経営上の理由による人員の削減」（必要条件の否定）
r34: -r6 -> -k5  ; L55 要件の否定による主張 経営理由 の不成立
r35: r7 & r8 & r9 -> x5  ; AND
r36: -r7 -> -x5  ; AND（必要条件の否定）
r37: -r8 -> -x5  ; AND（必要条件の否定）
r38: -r9 -> -x5  ; AND（必要条件の否定）
r39: -x5 -> -k6  ; L66 要件の否定による主張 承諾みなし の不成立
r40: k1 -> r7  ; L67 $期待 の参照
r41: -k1 -> -r7  ; L67 $期待 の参照（必要条件の否定）
r42: k3 -> r8  ; L68 $申込み の参照
r43: -k3 -> -r8  ; L68 $申込み の参照（必要条件の否定）
r44: k4 -> r9  ; L69 $理由欠如 の参照
r45: -k4 -> -r9  ; L69 $理由欠如 の参照（必要条件の否定）

[defaults]
e1: x1 : v1, r1 / v1  ; eval L8 評価 @これらを総合すればXが更新を期待したのは当然である
期待: f1, r1 : k1, c1, -ab1 / k1, c1  ; claim L6 主張 ^労働契約法19条2号
条項反論: f1, r2 : k2 / k2, ab1  ; claim L21 主張 ^契約書の更新条項
条項反論.不成立: ⊤ : -k2, c2 / c2  ; failure L24 主張 条項反論 が成立しないことからの結論
e3: f7 : v3, r3 / v3  ; eval L29 評価 @雇止めの撤回を求めていることは更新の申込みにあたる
申込み: f1, r3 : k3, c3 / k3, c3  ; claim L28 主張 ^労働契約法19条
e4: x2 : v4, r4 / v4  ; eval L36 評価 @雇止めは客観的に合理的な理由を欠く（AI: 疑わしい）
e5: x3 : v5, r5 / v5  ; eval L46 評価 @雇止めは社会通念上相当であるとは認められない（AI: 疑わしい）
理由欠如: f8, x4 : k4, c4 / k4, c4  ; claim L35 主張 ^労働契約法19条
e6: f13 : v6, r6 / v6  ; eval L57 評価 @経営上の理由による人員の削減にあたる
経営理由: f8, r6 : k5, -c4 / k5, -c4  ; claim L55 主張 ^経営上の理由による人員の削減は雇止めの合理的な理由になりうる
承諾みなし: f14, x5 : k6, c5 / k6, c5  ; claim L66 主張 ^労働契約法19条
条項の評価: f6 : r2 / r2  ; extra [extra] 【試算】Y社の評価（条項によって X は更新を当然に期待できなかった）が認められた場合

[priority]
条項反論 > 期待
条項反論 > 条項反論.不成立
理由欠如 > 経営理由

[extensions]
; 衝突しうるデフォルト: 期待, 条項反論.不成立, 理由欠如, 経営理由
E1 preferred:
  generating: e1, 条項反論, e3, 申込み, e4, e5, 理由欠如, e6, 条項の評価
  literals: f1, r1, f2, f3, f4, f5, x1, v1, k2, r2, f6, k3, r3, f7, v3, c3, k4, f8, r4, f9, f10, f11, f12, x2, v4, r5, x3, v5, x4, c4, r6, f13, v6, f14, r8, r9, ab1
E2:
  generating: e1, 条項反論, e3, 申込み, e4, e5, e6, 経営理由, 条項の評価
  literals: f1, r1, f2, f3, f4, f5, x1, v1, k2, r2, f6, k3, r3, f7, v3, c3, f8, r4, f9, f10, f11, f12, x2, v4, r5, x3, v5, x4, -c4, k5, r6, f13, v6, f14, r8, ab1

[marks]
! r2     L23 「Xは更新を当然に期待できなかった」  ; E1:不一致 E2:不一致
! k2     L21 #契約書の更新条項による反論  ; E1:不一致 E2:不一致

[summary]
extensions: 2 (preferred: 1)
skeptical: k2, k3, c3, k4, c4
credulous: k2, k3, c3, k4, c4
; 注: e2（L23 評価 @この条項は定型的な書式にすぎず実際の更新の運用とセンター長の発言に照らせばXの期待を打ち消すものではない）は AI の審査で棄却された
