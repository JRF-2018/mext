[W]
f1, f2, f3, f4, f5, f6, f7, f8, f9, f10

[rules]
r1: f2 -> r1  ; L8 %親切は評判への投資だと述べている
r2: -f2 -> -r1  ; L8 %親切は評判への投資だと述べている（必要条件の否定）
r3: -r1 -> -k1  ; L7 要件の否定による主張 甲野見解 の不成立
r4: v1 -> r3  ; L15 %人は見られているときに親切になる
r5: -v1 -> -r3  ; L15 %人は見られているときに親切になる（必要条件の否定）
r6: r2 & r3 -> x1  ; AND
r7: -r2 -> -x1  ; AND（必要条件の否定）
r8: -r3 -> -x1  ; AND（必要条件の否定）
r9: -x1 -> -k2  ; L13 要件の否定による主張 評判説 の不成立
r10: v2 -> r4  ; L20 %評判の得られない場面でも親切が行われる
r11: -v2 -> -r4  ; L20 %評判の得られない場面でも親切が行われる（必要条件の否定）
r12: -r4 -> -k3  ; L19 要件の否定による主張 山道反例 の不成立
r13: f7 -> r5  ; L27 %想像から生まれると述べている
r14: -f7 -> -r5  ; L27 %想像から生まれると述べている（必要条件の否定）
r15: -r5 -> -k4  ; L26 要件の否定による主張 乙川見解 の不成立
r16: v3 -> r6  ; L32 %経験のある人ほど親切だという傾向がある
r17: -v3 -> -r6  ; L32 %経験のある人ほど親切だという傾向がある（必要条件の否定）
r18: -r6 -> -k5  ; L31 要件の否定による主張 相関 の不成立
r19: r7 & r8 -> x2  ; AND
r20: -r7 -> -x2  ; AND（必要条件の否定）
r21: -r8 -> -x2  ; AND（必要条件の否定）
r22: -x2 -> -k6  ; L36 要件の否定による主張 賛同 の不成立
r23: -r9 -> -k7  ; L42 要件の否定による主張 示唆 の不成立
r24: f10 -> r10  ; L48 %因果の向きがわからない
r25: -f10 -> -r10  ; L48 %因果の向きがわからない（必要条件の否定）
r26: -r10 -> -k8  ; L47 要件の否定による主張 因果留保 の不成立
r27: r11 & r12 -> x3  ; AND
r28: -r11 -> -x3  ; AND（必要条件の否定）
r29: -r12 -> -x3  ; AND（必要条件の否定）
r30: -x3 -> -k9  ; L54 要件の否定による主張 結論 の不成立
r31: k1 -> r2  ; L14 $甲野見解 の参照
r32: -k1 -> -r2  ; L14 $甲野見解 の参照（必要条件の否定）
r33: k4 -> r7  ; L37 $乙川見解 の参照
r34: -k4 -> -r7  ; L37 $乙川見解 の参照（必要条件の否定）
r35: k5 -> r8  ; L38 $相関 の参照
r36: -k5 -> -r8  ; L38 $相関 の参照（必要条件の否定）
r37: k5 -> r9  ; L43 $相関 の参照
r38: -k5 -> -r9  ; L43 $相関 の参照（必要条件の否定）
r39: k3 -> r11  ; L55 $山道反例 の参照
r40: -k3 -> -r11  ; L55 $山道反例 の参照（必要条件の否定）
r41: k6 -> r12  ; L56 $賛同 の参照
r42: -k6 -> -r12  ; L56 $賛同 の参照（必要条件の否定）

[defaults]
甲野見解: f1, r1 : k1, c1 / k1, c1  ; claim L7 主張
e1: f4 : v1, r3 / v1  ; eval L15 評価 @人目があることが親切を増やしている
評判説: f3, x1 : k2, c2, -ab1 / k2, c2  ; claim L13 主張 ^評判への投資
e2: f5 : v2, r4 / v2  ; eval L20 評価 @人目のない場面での親切は評判への投資にならない
山道反例: f3, r4 : k3, -c2 / k3, -c2, ab1  ; claim L19 主張
乙川見解: f6, r5 : k4, c3 / k4, c3  ; claim L26 主張
e3: f9 : v3, r6 / v3  ; eval L32 評価 @よく聞く話は実際の傾向を示している
相関: f8, r6 : k5, c4 / k5, c4  ; claim L31 主張
賛同: f3, x2 : k6, c5, -ab2 / k6, c5  ; claim L36 主張
示唆: f3, r9 : k7, c6 / k7, c6  ; claim L42 主張
因果留保: f3, r10 : k8, c7 / k8, c7, ab2  ; claim L47 主張
結論: f3, x3 : k9, c8 / k9, c8  ; claim L54 主張

[priority]
因果留保 > 賛同
山道反例 > 評判説

[extensions]
; 衝突しうるデフォルト: 評判説, 山道反例, 賛同
E1:
  generating: 甲野見解, e1, 評判説, e2, 乙川見解, e3, 相関, 示唆, 因果留保
  literals: k1, f1, r1, f2, c1, k2, f3, r2, r3, f4, v1, x1, c2, r4, f5, v2, k4, f6, r5, f7, c3, k5, f8, r6, f9, v3, c4, r7, r8, x2, k7, r9, c6, k8, r10, f10, c7, ab2
E2 preferred:
  generating: 甲野見解, e1, e2, 山道反例, 乙川見解, e3, 相関, 示唆, 因果留保
  literals: k1, f1, r1, f2, c1, f3, r2, r3, f4, v1, x1, -c2, k3, r4, f5, v2, k4, f6, r5, f7, c3, k5, f8, r6, f9, v3, c4, r7, r8, x2, k7, r9, c6, k8, r10, f10, c7, r11, ab1, ab2

[marks]

[summary]
extensions: 2 (preferred: 1)
skeptical: k1, c1, -c2, k3, k4, c3, k5, c4, k7, c6, k8, c7
credulous: k1, c1, -c2, k3, k4, c3, k5, c4, k7, c6, k8, c7
; 検証の範囲: 評価 3 個（未審査 3・ok 0・doubtful 0・reject 0。doubtful と未審査の評価も推論を止めない）。最終的な結論 4 個のうち、成り立つもの 2 個、理論の中に対立する命題（否定）がないもの 3 個（これらは、反対の根拠に勝ったのではなく、反対の根拠が書かれていないだけである）。
