c7     concl  "見知らぬ人への親切は評判への投資だけでは説明できず自分も困るかもしれないという想像にも支えられていると考えられる〔見知らぬ人への親切〕"  ; L55

[W]
f1, f2, f3, f4, f5, f6, f7, f8, f9, f10

[rules]
r1: f2 -> r1  ; L8 %親切は評判への投資だと述べている
r2: -f2 -> -r1  ; L8 %親切は評判への投資だと述べている（必要条件の否定）
r3: -r1 -> -k1  ; L6 要件の否定による主張 甲野見解 の不成立
r4: v1 -> r3  ; L15 %人は見られているときに親切になる
r5: -v1 -> -r3  ; L15 %人は見られているときに親切になる（必要条件の否定）
r6: r2 & r3 -> x1  ; AND
r7: -r2 -> -x1  ; AND（必要条件の否定）
r8: -r3 -> -x1  ; AND（必要条件の否定）
r9: -x1 -> -k2  ; L12 要件の否定による主張 評判説 の不成立
r10: f5 -> r4  ; L22 %人目のないところでも見知らぬ人への親切が行われる
r11: -f5 -> -r4  ; L22 %人目のないところでも見知らぬ人への親切が行われる（必要条件の否定）
r12: v2 -> r5  ; L24 %人目のないところでの親切は評判への投資にならない
r13: -v2 -> -r5  ; L24 %人目のないところでの親切は評判への投資にならない（必要条件の否定）
r14: r4 & r5 -> x2  ; AND
r15: -r4 -> -x2  ; AND（必要条件の否定）
r16: -r5 -> -x2  ; AND（必要条件の否定）
r17: -x2 -> -k3  ; L20 要件の否定による主張 評判限界 の不成立
r18: f7 -> r6  ; L30 %親切は想像から生まれると述べている
r19: -f7 -> -r6  ; L30 %親切は想像から生まれると述べている（必要条件の否定）
r20: -r6 -> -k4  ; L29 要件の否定による主張 乙川見解 の不成立
r21: v3 -> r8  ; L37 %旅先で助けられた経験のある人ほど見知らぬ人に親切である
r22: -v3 -> -r8  ; L37 %旅先で助けられた経験のある人ほど見知らぬ人に親切である（必要条件の否定）
r23: v4 -> r9  ; L39 %助けられた経験は自分も困るかもしれないという想像を通じて親切を生む
r24: -v4 -> -r9  ; L39 %助けられた経験は自分も困るかもしれないという想像を通じて親切を生む（必要条件の否定）
r25: r7 & r8 & r9 -> x3  ; AND
r26: -r7 -> -x3  ; AND（必要条件の否定）
r27: -r8 -> -x3  ; AND（必要条件の否定）
r28: -r9 -> -x3  ; AND（必要条件の否定）
r29: -x3 -> -k5  ; L34 要件の否定による主張 賛同 の不成立
r30: f10 -> r10  ; L47 %想像と親切の因果の向きがわからない
r31: -f10 -> -r10  ; L47 %想像と親切の因果の向きがわからない（必要条件の否定）
r32: -r10 -> -k6  ; L45 要件の否定による主張 限定 の不成立
r33: r11 & r12 -> x4  ; AND
r34: -r11 -> -x4  ; AND（必要条件の否定）
r35: -r12 -> -x4  ; AND（必要条件の否定）
r36: -x4 -> -k7  ; L52 要件の否定による主張 結論 の不成立
r37: k1 -> r2  ; L13 $甲野見解 の参照
r38: -k1 -> -r2  ; L13 $甲野見解 の参照（必要条件の否定）
r39: k4 -> r7  ; L35 $乙川見解 の参照
r40: -k4 -> -r7  ; L35 $乙川見解 の参照（必要条件の否定）
r41: k3 -> r11  ; L53 $評判限界 の参照
r42: -k3 -> -r11  ; L53 $評判限界 の参照（必要条件の否定）
r43: k5 -> r12  ; L54 $賛同 の参照
r44: -k5 -> -r12  ; L54 $賛同 の参照（必要条件の否定）

[defaults]
甲野見解: f1, r1 : k1, c1 / k1, c1  ; claim L6 主張
e1: f4 : v1, r3 / v1  ; eval L15 評価 @親切な行動の多さの違いは人目の有無による（AI: 疑わしい）
評判説: f3, x1 : k2, c2 / k2, c2  ; claim L12 主張
e2: f5 : v2, r5 / v2  ; eval L24 評価 @人目がなければその親切が評判として広まることはない（AI: 疑わしい）
評判限界: f3, x2 : k3, c3 / k3, c3  ; claim L20 主張
乙川見解: f6, r6 : k4, c4 / k4, c4  ; claim L29 主張
e3: f8 : v3, r8 / v3  ; eval L37 評価 @よく聞く話から経験と親切の結びつきを認める（AI: 疑わしい）
e4: f8 : v4, r9 / v4  ; eval L39 評価 @経験と親切の結びつきは想像を介している（AI: 疑わしい）
賛同: f3, x3 : k5, c5 / k5, c5  ; claim L34 主張 ^旅先で助けられた経験
限定: f9, r10 : k6, c6 / k6, c6  ; claim L45 主張
結論: f3, x4 : k7, c7 / k7, c7  ; claim L52 主張
限定による阻却: k6 : -c5 / -c5  ; extra [extra] 因果の向きが不明なら、想像から親切が生まれるとは言えない

[priority]
限定による阻却 > 賛同

[extensions]
; 衝突しうるデフォルト: 賛同, 限定による阻却
E1:
  generating: 甲野見解, e1, 評判説, e2, 評判限界, 乙川見解, e3, e4, 賛同, 限定, 結論
  literals: k1, f1, r1, f2, c1, k2, f3, r2, r3, f4, v1, x1, c2, k3, r4, f5, r5, v2, x2, c3, k4, f6, r6, f7, c4, k5, r7, r8, f8, v3, r9, v4, x3, c5, k6, f9, r10, f10, c6, k7, r11, r12, x4, c7
E2 preferred:
  generating: 甲野見解, e1, 評判説, e2, 評判限界, 乙川見解, e3, e4, 限定, 限定による阻却
  literals: k1, f1, r1, f2, c1, k2, f3, r2, r3, f4, v1, x1, c2, k3, r4, f5, r5, v2, x2, c3, k4, f6, r6, f7, c4, r7, r8, f8, v3, r9, v4, x3, -c5, k6, f9, r10, f10, c6, r11

[marks]

[summary]
extensions: 2 (preferred: 1)
skeptical: k1, c1, k2, c2, k3, c3, k4, c4, -c5, k6, c6
credulous: k1, c1, k2, c2, k3, c3, k4, c4, -c5, k6, c6
