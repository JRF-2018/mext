@mext 1
theory: remote_work_op.matcha
; MEXT: Matcha EXTension notation。書式は mext の docs/mext.md（スキルでは references/mext.md）を参照。

[ai]
; AI（または人）の判断。各行の ; 以降に理由を書く。
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject
review "民間の調査でリモートワークを導入した会社の6割が生産性は下がらなかったと答えた@リモートワークで生産性は下がらない" doubtful  ; 6割が「下がらなかった」は、裏返せば最大4割で下がったことを含みうる。全体についての「下がらない」への一般化は飛躍。導入を続けた会社の自己申告であり（選択の偏り）、事務職に限った数字でもない。「下がらない」ことは「出社の負担を課す理由がない」の十分条件としても、生産性以外の出社の理由（第5・6段落で文書自身が挙げる）を除外していない
review "子育てや介護を担う人や地方に住む人は毎日の出社が条件なら働けない@リモートワークを原則にすればそうした人たちを採用できる" doubtful  ; 事実は「毎日の出社」が条件の場合の話で、対案の「出社を原則」とは同じでない（週数日の出社などの中間の制度でも採用できうる）。「毎日出社」と「出社原則」のすり替えの疑い。地方に住む人は、例外としての出社（第5段落）にも応じにくい
review "人材／%人手不足の時代である" ok  ; 評価を挟まない事実の主張。根拠は示されていないが、一般的な認識として争いは小さい
review "オフィスの面積を減らせば賃料と光熱費を大きく削れる@リモートワークを原則にすればオフィスの面積を減らし賃料と光熱費を大きく削れる" doubtful  ; 事実は「面積を減らせば削れる」という条件文で、ほぼ自明。「リモートワークを原則にすれば面積を減らせる」という段階が書かれていない。例外としての出社（新人教育・企画初期）の日にも席は要る。社員の自宅の光熱費・通信費への費用の移転も考慮されていない。「大きく」の程度も示されない
review "例外出社／%出社に意味がある" ok  ; 文書自身が認めた譲歩で、評価を挟まない
review "出社に意味がある場面は新人の教育や企画の初期段階などである@出社に意味がある場面は例外にとどまる" reject  ; 試算: 出社場面の反論への再反論を退けた場合。以下、元の理由  ; 「など」で開かれた列挙であり、その場面の頻度・広さは示されていない。事務職でも新人教育や企画初期が常にある職場では「例外」にとどまらない。「例外として求めるべきもの」は、争われている原則と例外の割り振りそのものを前提にしており、循環の疑いがある
review "（L50 の事実群）@対面でなくても一体感は失われない" reject  ; 試算: 一体感の反論への再反論を退けた場合。以下、元の理由  ; 「同じ部屋にいることからではなく目標の共有から」は二者択一の前提で、両方から生まれる可能性を排除する根拠がない（偽の二分法）。「オンラインでも目標は共有できる」ことから「一体感が失われない」までも飛躍がある。いずれも根拠（調査など）が示されていない

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2

[claimed]
;   E1*: "文言", -"文言"   … 検証したい Extension（* は preferred であることも主張）
E1*: "事務職はリモートワークを原則とし出社は理由を示した例外とすべきである〔事務職〕", "通勤という負担を社員に課し続ける理由はない〔事務職〕", "リモートワークを原則にすれば人材を確保できる〔事務職〕", "リモートワークを原則にすれば費用を削れる〔事務職〕", "そうした場面では理由を示して出社を求めればよい〔新人の教育や企画の初期段階〕", "出社に意味がある場面は出社そのものを原則にする理由にならない〔事務職〕", "一体感の喪失は出社を原則にする理由にならない〔事務職〕", -"一体感／「対面でなければ社員の一体感が失われる」", !"一体感", !"出社場面"   ; 衝突しうるデフォルトがなく（反論の要件を積極的に満たす事実がない）、Extension は一つで、三つの根拠がそろって結論が出ると予測する。二つの反論は要件の否定により不成立

; ===== ここから下は mext.py が自動生成（手で直さない） =====
[atoms]
k1     claim  "#通勤負担の不要^生産性が下がらないなら通勤負担を課す理由はない [生産性]"  ; L6
f1     fact   "事務職"  ; L6,L12,L20,L28,L41,L48
r1     req    "生産性／%リモートワークで生産性が下がらない"  ; L8
f2     fact   "民間の調査でリモートワークを導入した会社の6割が生産性は下がらなかったと答えた"  ; L8
v1     eval   "民間の調査でリモートワークを導入した会社の6割が生産性は下がらなかったと答えた@リモートワークで生産性は下がらない"  ; L8
c1     concl  "通勤という負担を社員に課し続ける理由はない〔事務職〕"  ; L9
k2     claim  "#人材の確保^人手不足の時代に採用の機会を捨てるべきでない [人材]"  ; L12
r2     req    "人材／%リモートワークを原則にすれば子育てや介護を担う人や地方に住む人を採用できる"  ; L14
f3     fact   "子育てや介護を担う人や地方に住む人は毎日の出社が条件なら働けない"  ; L14
v2     eval   "子育てや介護を担う人や地方に住む人は毎日の出社が条件なら働けない@リモートワークを原則にすればそうした人たちを採用できる"  ; L14
r3     req    "人材／%人手不足の時代である"  ; L16
f4     fact   "人手不足の時代である"  ; L16
x1     aux    "（L12 の AND・2項・1）"  ; L12
c2     concl  "リモートワークを原則にすれば人材を確保できる〔事務職〕"  ; L17
k3     claim  "#費用の削減^費用 [費用]"  ; L20
r4     req    "費用／%リモートワークを原則にすればオフィスの費用を大きく削れる"  ; L22
f5     fact   "オフィスの面積を減らせば賃料と光熱費を大きく削れる"  ; L22
v3     eval   "オフィスの面積を減らせば賃料と光熱費を大きく削れる@リモートワークを原則にすればオフィスの面積を減らし賃料と光熱費を大きく削れる"  ; L22
c3     concl  "リモートワークを原則にすれば費用を削れる〔事務職〕"  ; L23
k4     claim  "#リモートワークの原則化 [原則]"  ; L28
r5     req    "原則／$生産性"  ; L29
r6     req    "原則／$人材"  ; L30
r7     req    "原則／$費用"  ; L31
x2     aux    "（L28 の AND・3項・1）"  ; L28
c4     concl  "事務職はリモートワークを原則とし出社は理由を示した例外とすべきである〔事務職〕"  ; L32
k5     claim  "#例外としての出社 [例外出社]"  ; L36
f6     fact   "新人の教育や企画の初期段階"  ; L36
r8     req    "例外出社／%出社に意味がある"  ; L37
f7     fact   "新人の教育や顔を合わせての議論が欠かせない企画の初期段階では出社に意味がある"  ; L37
c5     concl  "そうした場面では理由を示して出社を求めればよい〔新人の教育や企画の初期段階〕"  ; L38
k6     claim  "#出社原則の理由^出社に意味がある場面 [出社場面]"  ; L41
r9     req    "出社場面／「出社そのものを原則にする理由」"  ; L43
f8     fact   "出社に意味がある場面は新人の教育や企画の初期段階などである"  ; L43
v4     eval   "出社に意味がある場面は新人の教育や企画の初期段階などである@出社に意味がある場面は例外にとどまる"  ; L43
c6     concl  "出社に意味がある場面は出社そのものを原則にする理由にならない〔事務職〕"  ; L44
k7     claim  "#一体感の反論^対面でなければ一体感が失われる [一体感]"  ; L48
r10    req    "一体感／「対面でなければ社員の一体感が失われる」"  ; L50
f9     fact   "一体感は毎日同じ部屋にいることからではなく目標を共有することから生まれる"  ; L50
f10    fact   "オンラインでも目標は共有できる"  ; L50
x3     aux    "（L50 の AND・2項・1）"  ; L50
v5     eval   "（L50 の事実群）@対面でなくても一体感は失われない"  ; L50
c7     concl  "一体感の喪失は出社を原則にする理由にならない〔事務職〕"  ; L51

[W]
f1, f2, f3, f4, f5, f6, f7, f8, f9, f10

[rules]
r1: v1 -> r1  ; L8 %リモートワークで生産性が下がらない
r2: -v1 -> -r1  ; L8 %リモートワークで生産性が下がらない（必要条件の否定）
r3: -r1 -> -k1  ; L6 要件の否定による主張 生産性 の不成立
r4: v2 -> r2  ; L14 %リモートワークを原則にすれば子育てや介護を担う人や地方に住む人を採用できる
r5: -v2 -> -r2  ; L14 %リモートワークを原則にすれば子育てや介護を担う人や地方に住む人を採用できる（必要条件の否定）
r6: f4 -> r3  ; L16 %人手不足の時代である
r7: -f4 -> -r3  ; L16 %人手不足の時代である（必要条件の否定）
r8: r2 & r3 -> x1  ; AND
r9: -r2 -> -x1  ; AND（必要条件の否定）
r10: -r3 -> -x1  ; AND（必要条件の否定）
r11: -x1 -> -k2  ; L12 要件の否定による主張 人材 の不成立
r12: v3 -> r4  ; L22 %リモートワークを原則にすればオフィスの費用を大きく削れる
r13: -v3 -> -r4  ; L22 %リモートワークを原則にすればオフィスの費用を大きく削れる（必要条件の否定）
r14: -r4 -> -k3  ; L20 要件の否定による主張 費用 の不成立
r15: r5 & r6 & r7 -> x2  ; AND
r16: -r5 -> -x2  ; AND（必要条件の否定）
r17: -r6 -> -x2  ; AND（必要条件の否定）
r18: -r7 -> -x2  ; AND（必要条件の否定）
r19: -x2 -> -k4  ; L28 要件の否定による主張 原則 の不成立
r20: f7 -> r8  ; L37 %出社に意味がある
r21: -f7 -> -r8  ; L37 %出社に意味がある（必要条件の否定）
r22: -r8 -> -k5  ; L36 要件の否定による主張 例外出社 の不成立
r23: v4 -> -r9  ; L43 「出社そのものを原則にする理由」（不成立の根拠）
r24: -r9 -> -k6  ; L41 要件の否定による主張 出社場面 の不成立
r25: f9 & f10 -> x3  ; AND
r26: -f9 -> -x3  ; AND（必要条件の否定）
r27: -f10 -> -x3  ; AND（必要条件の否定）
r28: v5 -> -r10  ; L50 「対面でなければ社員の一体感が失われる」（不成立の根拠）
r29: -r10 -> -k7  ; L48 要件の否定による主張 一体感 の不成立
r30: k1 -> r5  ; L29 $生産性 の参照
r31: -k1 -> -r5  ; L29 $生産性 の参照（必要条件の否定）
r32: k2 -> r6  ; L30 $人材 の参照
r33: -k2 -> -r6  ; L30 $人材 の参照（必要条件の否定）
r34: k3 -> r7  ; L31 $費用 の参照
r35: -k3 -> -r7  ; L31 $費用 の参照（必要条件の否定）

[defaults]
e1: f2 : v1, r1 / v1  ; eval L8 評価 @リモートワークで生産性は下がらない（AI: 疑わしい）
生産性: f1, r1 : k1, c1 / k1, c1  ; claim L6 主張 ^生産性が下がらないなら通勤負担を課す理由はない
e2: f3 : v2, r2 / v2  ; eval L14 評価 @リモートワークを原則にすればそうした人たちを採用できる（AI: 疑わしい）
人材: f1, x1 : k2, c2 / k2, c2  ; claim L12 主張 ^人手不足の時代に採用の機会を捨てるべきでない
e3: f5 : v3, r4 / v3  ; eval L22 評価 @リモートワークを原則にすればオフィスの面積を減らし賃料と光熱費を大きく削れる（AI: 疑わしい）
費用: f1, r4 : k3, c3 / k3, c3  ; claim L20 主張 ^費用
原則: f1, x2 : k4, c4 / k4, c4  ; claim L28 主張
例外出社: f6, r8 : k5, c5 / k5, c5  ; claim L36 主張
出社場面: f1, r9 : k6 / k6  ; claim L41 主張 ^出社に意味がある場面
出社場面.不成立: ⊤ : -k6, c6 / c6  ; failure L44 主張 出社場面 が成立しないことからの結論
一体感: f1, r10 : k7 / k7  ; claim L48 主張 ^対面でなければ一体感が失われる
一体感.不成立: ⊤ : -k7, c7 / c7  ; failure L51 主張 一体感 が成立しないことからの結論

[priority]
一体感 > 一体感.不成立
出社場面 > 出社場面.不成立

[extensions]
; 衝突しうるデフォルト: なし
E1 preferred:
  generating: e1, 生産性, e2, 人材, e3, 費用, 原則, 例外出社, 出社場面.不成立, 一体感.不成立
  literals: k1, f1, r1, f2, v1, c1, k2, r2, f3, v2, r3, f4, x1, c2, k3, r4, f5, v3, c3, k4, r5, r6, r7, x2, c4, k5, f6, r8, f7, c5, f8, c6, f9, f10, x3, c7

[marks]
! r9     L43 「出社そのものを原則にする理由」  ; E1:一致
! k6     L41 #出社原則の理由  ; E1:一致
! r10    L50 「対面でなければ社員の一体感が失われる」  ; E1:一致
! k7     L48 #一体感の反論  ; E1:一致

[summary]
extensions: 1 (preferred: 1)
skeptical: k1, c1, k2, c2, k3, c3, k4, c4, k5, c5, c6, c7
credulous: k1, c1, k2, c2, k3, c3, k4, c4, k5, c5, c6, c7
; 注: e4（L43 評価 @出社に意味がある場面は例外にとどまる）は AI の審査で棄却された
; 注: e5（L50 評価 @対面でなくても一体感は失われない）は AI の審査で棄却された
