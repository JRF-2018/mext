r26: -r9 -> -x3  ; AND（必要条件の否定）
r27: -r10 -> -x3  ; AND（必要条件の否定）
r28: -x3 -> -k7  ; L45 要件の否定による主張 結論 の不成立
r29: k1 -> r2  ; L14 $甲野見解 の参照
r30: -k1 -> -r2  ; L14 $甲野見解 の参照（必要条件の否定）
r31: k4 -> r6  ; L32 $乙川見解 の参照
r32: -k4 -> -r6  ; L32 $乙川見解 の参照（必要条件の否定）
