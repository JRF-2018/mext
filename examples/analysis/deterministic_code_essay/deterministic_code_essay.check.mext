@mext 1
theory: deterministic_code_essay.matcha
; MEXT: Matcha EXTension notation。書式は mext の docs/mext.md（スキルでは references/mext.md）を参照。

[ai]
; AI（または人）の判断。各行の ; 以降に理由を書く。
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2

[claimed]
;   E1*: "文言", -"文言"   … 検証したい Extension（* は preferred であることも主張）

; ===== ここから下は mext.py が自動生成（手で直さない） =====
[atoms]
k1     claim  "#判断の揺れの問題^業務の判断には一貫性が求められる [揺れ問題]"  ; L9
f1     fact   "業務の判断を AI に直接させること"  ; L9
r1     req    "揺れ問題／%同じ質問に違う答えを返す"  ; L10
f2     fact   "大規模言語モデルは、同じ質問に対しても、ときに違う答えを返す"  ; L10
c1     concl  "業務の判断を AI に直接させると、判断の揺れが問題になる〔業務の判断を AI に直接させること〕"  ; L11
k2     claim  "#直接判断の回避^判断の揺れ [回避_書ける]"  ; L15
f3     fact   "規則として書き下せる判断"  ; L15,L27
r2     req    "回避_書ける／$揺れ問題"  ; L16
c2     concl  "規則として書き下せる判断を AI に直接させる〔規則として書き下せる判断〕"  ; L17
k3     claim  "#直接判断の回避^判断の揺れ [回避_書けない]"  ; L19
f4     fact   "規則として書き下せない判断"  ; L19,L40,L43
r3     req    "回避_書けない／$揺れ問題"  ; L20
c3     concl  "規則として書き下せない判断を AI に直接させる〔規則として書き下せない判断〕"  ; L21,L44
k4     claim  "#コードによる判断^三つの理由 [コード判断]"  ; L27
r4     req    "コード判断／$揺れ問題"  ; L28
r5     req    "コード判断／%判断の揺れがない"  ; L30
f5     fact   "コードは同じ入力に同じ出力を返す"  ; L30
v1     eval   "コードは同じ入力に同じ出力を返す@判断の揺れがなくなる"  ; L30
r6     req    "コード判断／%判断を後から検証できる"  ; L32
f6     fact   "コードは人が読める"  ; L32
v2     eval   "コードは人が読める@判断がなぜそうなったかを後から検証できる"  ; L32
r7     req    "コード判断／%誤りが再発しない"  ; L34
f7     fact   "コードの誤りは一度直せば二度と起きない"  ; L34
f8     fact   "AI の判断の誤りは次にまた起きるかもしれない"  ; L34
x1     aux    "（L34 の AND・2項・1）"  ; L34
v3     eval   "（コードの誤りは一度直せば二度と起きない & AI の判断の誤りは次にまた起きるかもしれない）@コードのほうが誤りの再発を防げる"  ; L34
x2     aux    "（L27 の AND・4項・1）"  ; L27
c4     concl  "規則として書き下せる判断は AI に書かせたコードで行うべきである〔規則として書き下せる判断〕"  ; L35
k5     claim  "#AI に任せるしかない [AI直接]"  ; L40
r8     req    "AI直接／%規則として書き下せない"  ; L41
f9     fact   "文章の意味を読み取る判断、事実を評価する判断"  ; L41
v4     eval   "文章の意味を読み取る判断、事実を評価する判断@規則として書き下せない"  ; L41
r9     req    "AI直接／%AI に任せるしかない"  ; L43
v5     eval   "規則として書き下せない判断@AI のほかに任せる先がない"  ; L43
x3     aux    "（L40 の AND・2項・1）"  ; L40
k6     claim  "#記録と分離 [記録分離]"  ; L48
f10    fact   "AI に直接させる判断"  ; L48
r10    req    "記録分離／$AI直接"  ; L49
c5     concl  "AI の判断を理由とともに記録し、コードの部分と分けておくべきである〔AI に直接させる判断〕"  ; L50
k7     claim  "#AI を使うシステムの設計 [結論]"  ; L55
f11    fact   "AI を使うシステム"  ; L55
r11    req    "結論／$コード判断"  ; L56
r12    req    "結論／$回避_書ける"  ; L57
r13    req    "結論／$AI直接"  ; L58
x4     aux    "（L55 の AND・3項・1）"  ; L55
c6     concl  "AI を使うシステムでは、規則として書き下せる判断はすべて AI に書かせたコードで行い、書き下せない判断だけを AI に直接させるべきである〔AI を使うシステム〕"  ; L59
ab1    ab     "ab(回避_書けない)"

[W]
f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11

[rules]
r1: f2 -> r1  ; L10 %同じ質問に違う答えを返す
r2: -f2 -> -r1  ; L10 %同じ質問に違う答えを返す（必要条件の否定）
r3: -r1 -> -k1  ; L9 要件の否定による主張 揺れ問題 の不成立
r4: -r2 -> -k2  ; L15 要件の否定による主張 回避_書ける の不成立
r5: -r3 -> -k3  ; L19 要件の否定による主張 回避_書けない の不成立
r6: v1 -> r5  ; L30 %判断の揺れがない
r7: -v1 -> -r5  ; L30 %判断の揺れがない（必要条件の否定）
r8: v2 -> r6  ; L32 %判断を後から検証できる
r9: -v2 -> -r6  ; L32 %判断を後から検証できる（必要条件の否定）
r10: f7 & f8 -> x1  ; AND
r11: -f7 -> -x1  ; AND（必要条件の否定）
r12: -f8 -> -x1  ; AND（必要条件の否定）
r13: v3 -> r7  ; L34 %誤りが再発しない
r14: -v3 -> -r7  ; L34 %誤りが再発しない（必要条件の否定）
r15: r4 & r5 & r6 & r7 -> x2  ; AND
r16: -r4 -> -x2  ; AND（必要条件の否定）
r17: -r5 -> -x2  ; AND（必要条件の否定）
r18: -r6 -> -x2  ; AND（必要条件の否定）
r19: -r7 -> -x2  ; AND（必要条件の否定）
r20: -x2 -> -k4  ; L27 要件の否定による主張 コード判断 の不成立
r21: v4 -> r8  ; L41 %規則として書き下せない
r22: -v4 -> -r8  ; L41 %規則として書き下せない（必要条件の否定）
r23: v5 -> r9  ; L43 %AI に任せるしかない
r24: -v5 -> -r9  ; L43 %AI に任せるしかない（必要条件の否定）
r25: r8 & r9 -> x3  ; AND
r26: -r8 -> -x3  ; AND（必要条件の否定）
r27: -r9 -> -x3  ; AND（必要条件の否定）
r28: -x3 -> -k5  ; L40 要件の否定による主張 AI直接 の不成立
r29: -r10 -> -k6  ; L48 要件の否定による主張 記録分離 の不成立
r30: r11 & r12 & r13 -> x4  ; AND
r31: -r11 -> -x4  ; AND（必要条件の否定）
r32: -r12 -> -x4  ; AND（必要条件の否定）
r33: -r13 -> -x4  ; AND（必要条件の否定）
r34: -x4 -> -k7  ; L55 要件の否定による主張 結論 の不成立
r35: k1 -> r2  ; L16 $揺れ問題 の参照
r36: -k1 -> -r2  ; L16 $揺れ問題 の参照（必要条件の否定）
r37: k1 -> r3  ; L20 $揺れ問題 の参照
r38: -k1 -> -r3  ; L20 $揺れ問題 の参照（必要条件の否定）
r39: k1 -> r4  ; L28 $揺れ問題 の参照
r40: -k1 -> -r4  ; L28 $揺れ問題 の参照（必要条件の否定）
r41: k5 -> r10  ; L49 $AI直接 の参照
r42: -k5 -> -r10  ; L49 $AI直接 の参照（必要条件の否定）
r43: k4 -> r11  ; L56 $コード判断 の参照
r44: -k4 -> -r11  ; L56 $コード判断 の参照（必要条件の否定）
r45: k2 -> r12  ; L57 $回避_書ける の参照
r46: -k2 -> -r12  ; L57 $回避_書ける の参照（必要条件の否定）
r47: k5 -> r13  ; L58 $AI直接 の参照
r48: -k5 -> -r13  ; L58 $AI直接 の参照（必要条件の否定）

[defaults]
揺れ問題: f1, r1 : k1, c1 / k1, c1  ; claim L9 主張 ^業務の判断には一貫性が求められる
回避_書ける: f3, r2 : k2, -c2 / k2, -c2  ; claim L15 主張 ^判断の揺れ
回避_書けない: f4, r3 : k3, -c3, -ab1 / k3, -c3  ; claim L19 主張 ^判断の揺れ
e1: f5 : v1, r5 / v1  ; eval L30 評価 @判断の揺れがなくなる
e2: f6 : v2, r6 / v2  ; eval L32 評価 @判断がなぜそうなったかを後から検証できる
e3: x1 : v3, r7 / v3  ; eval L34 評価 @コードのほうが誤りの再発を防げる
コード判断: f3, x2 : k4, c4 / k4, c4  ; claim L27 主張 ^三つの理由
e4: f9 : v4, r8 / v4  ; eval L41 評価 @規則として書き下せない
e5: f4 : v5, r9 / v5  ; eval L43 評価 @AI のほかに任せる先がない
AI直接: f4, x3 : k5, c3 / k5, c3, ab1  ; claim L40 主張
記録分離: f10, r10 : k6, c5 / k6, c5  ; claim L48 主張
結論: f11, x4 : k7, c6 / k7, c6  ; claim L55 主張

[priority]
AI直接 > 回避_書けない

[extensions]
; 衝突しうるデフォルト: 回避_書けない, AI直接
E1:
  generating: 揺れ問題, 回避_書ける, 回避_書けない, e1, e2, e3, コード判断, e4, e5
  literals: k1, f1, r1, f2, c1, k2, f3, r2, -c2, k3, f4, r3, -c3, k4, r4, r5, f5, v1, r6, f6, v2, r7, f7, f8, x1, v3, x2, c4, r8, f9, v4, r9, v5, x3, f10, f11, r11, r12
E2 preferred:
  generating: 揺れ問題, 回避_書ける, e1, e2, e3, コード判断, e4, e5, AI直接, 記録分離, 結論
  literals: k1, f1, r1, f2, c1, k2, f3, r2, -c2, f4, r3, c3, k4, r4, r5, f5, v1, r6, f6, v2, r7, f7, f8, x1, v3, x2, c4, k5, r8, f9, v4, r9, v5, x3, k6, f10, r10, c5, k7, f11, r11, r12, r13, x4, c6, ab1

[marks]

[summary]
extensions: 2 (preferred: 1)
skeptical: k1, c1, k2, -c2, c3, k4, c4, k5, k6, c5, k7, c6
credulous: k1, c1, k2, -c2, c3, k4, c4, k5, k6, c5, k7, c6
