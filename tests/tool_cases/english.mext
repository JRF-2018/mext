@mext 1
theory: english.matcha
source: english.matcha sha256=241a8c535651bacd
; MEXT: Matcha EXTension notation。書式は mext の docs/mext.md（スキルでは references/mext.md）を参照。

[ai]
; AI（または人）の判断。各行の ; 以降に理由を書く。
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject
;   concern 名 "前提" "前提" …    … 内容の上で一つの争点を共有する前提（感度分析でまとめて外す）
;   distinct "前提" "前提" …      … 内容の上で互いに独立な前提
;   connective "主張のラベルか要件の文言" 明示|読み … 結び方（AND/OR）が原文に明示されているか
;   fact-kind "事実" 記述|仮定|確認済み|著者の主張 … W の事実の種別
;   supplied "前提" …              … 原文になく、書き起こした者が補った前提

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2

[claimed]
;   E1*: "文言", -"文言"   … 検証したい Extension（* は preferred であることも主張）

; ===== ここから下は mext.py が自動生成（手で直さない） =====
[atoms]
k1     claim  "#Safety^Public safety [safety]"  ; L2
f1     fact   "downtown core"  ; L2,L6,L10,L15
r1     req    "safety／%Cars cause most injuries"  ; L3
f2     fact   "most serious injuries downtown involve private cars"  ; L3
v1     eval   "most serious injuries downtown involve private cars@cars are the main danger"  ; L3
c1     concl  "removing the cars makes downtown safer〔downtown core〕"  ; L4
k2     claim  "#Business^Survey [business]"  ; L6
r2     req    "business／%Shops gain"  ; L7
f3     fact   "pedestrians visit shops more often"  ; L7
v2     eval   "pedestrians visit shops more often@shops would gain customers"  ; L7
c2     concl  "a car-free center helps shops〔downtown core〕"  ; L8
k3     claim  "#Plan [plan]"  ; L10
r3     req    "plan／$safety"  ; L11
r4     req    "plan／$business"  ; L12
x1     aux    "（L10 AND/2 #1）"  ; L10
c3     concl  "the city should adopt the plan〔downtown core〕"  ; L13,L17
k4     claim  "#Objection^Access [objection]"  ; L15
r5     req    "objection／%Some people depend on cars"  ; L16
f4     fact   "some people with disabilities depend on cars"  ; L16
v3     eval   "some people with disabilities depend on cars@the plan harms them"  ; L16

[W]
f1, f2, f3, f4

[rules]
r1: v1 -> r1  ; L3 %Cars cause most injuries
r2: -v1 -> -r1  ; L3 %Cars cause most injuries（必要条件の否定）
r3: -r1 -> -k1  ; L2 要件の否定による主張 safety の不成立
r4: v2 -> r2  ; L7 %Shops gain
r5: -v2 -> -r2  ; L7 %Shops gain（必要条件の否定）
r6: -r2 -> -k2  ; L6 要件の否定による主張 business の不成立
r7: r3 & r4 -> x1  ; AND
r8: -r3 -> -x1  ; AND（必要条件の否定）
r9: -r4 -> -x1  ; AND（必要条件の否定）
r10: -x1 -> -k3  ; L10 要件の否定による主張 plan の不成立
r11: v3 -> r5  ; L16 %Some people depend on cars
r12: -v3 -> -r5  ; L16 %Some people depend on cars（必要条件の否定）
r13: -r5 -> -k4  ; L15 要件の否定による主張 objection の不成立
r14: k1 -> r3  ; L11 $safety の参照
r15: -k1 -> -r3  ; L11 $safety の参照（必要条件の否定）
r16: k2 -> r4  ; L12 $business の参照
r17: -k2 -> -r4  ; L12 $business の参照（必要条件の否定）

[defaults]
e1: f2 : v1, r1 / v1  ; eval L3 評価 @cars are the main danger
safety: f1, r1 : k1, c1 / k1, c1  ; claim L2 主張 ^Public safety
e2: f3 : v2, r2 / v2  ; eval L7 評価 @shops would gain customers
business: f1, r2 : k2, c2 / k2, c2  ; claim L6 主張 ^Survey
plan: f1, x1 : k3, c3 / k3, c3  ; claim L10 主張
e3: f4 : v3, r5 / v3  ; eval L16 評価 @the plan harms them
objection: f1, r5 : k4, -c3 / k4, -c3  ; claim L15 主張 ^Access

[priority]
plan > objection

[extensions]
; 衝突しうるデフォルト: plan, objection
E1 preferred:
  generating: e1, safety, e2, business, plan, e3
  literals: k1, f1, r1, f2, v1, c1, k2, r2, f3, v2, c2, k3, r3, r4, x1, c3, r5, f4, v3
E2:
  generating: e1, safety, e2, business, e3, objection
  literals: k1, f1, r1, f2, v1, c1, k2, r2, f3, v2, c2, r3, r4, x1, -c3, k4, r5, f4, v3

[marks]

[summary]
extensions: 2 (preferred: 1)
skeptical: k1, c1, k2, c2, k3, c3
credulous: k1, c1, k2, c2, k3, c3
; 検証の範囲: 評価 3 個（未審査 3・ok 0・doubtful 0・reject 0。doubtful と未審査の評価も推論を止めない）。最終的な結論 2 個のうち、成り立つもの 1 個、理論の中に対立する命題（否定）がないもの 0 個。
