@mext 1
theory: report_eval.matcha
source: report_eval.matcha sha256=9dce2bc5baf18625
; MEXT: Matcha EXTension notation。書式は mext の docs/mext.md（スキルでは references/mext.md）を参照。

[ai]
; AI（または人）の判断。各行の ; 以降に理由を書く。
;   文言は "…" で囲む（文言に " を含むなら '…' で囲むか、\" と書く）
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject
;   concern 名 "前提" "前提" …    … 内容の上で一つの争点を共有する前提（感度分析でまとめて外す）
;   distinct "前提" "前提" …      … 内容の上で互いに独立な前提
;   connective "主張のラベルか要件の文言" 明示|読み … 結び方（AND/OR）が原文に明示されているか
;   fact-kind "事実" 記述|仮定|確認済み|著者の主張 … W の事実の種別
;   supplied "前提" …              … 原文になく、書き起こした者が補った前提

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2

[claimed]
;   E1*: "文言", -"文言"   … 検証したい Extension（* は preferred であることも主張）

; ===== ここから下は mext.py が自動生成（手で直さない） =====
[atoms]
k1     claim  "#出生差への応答 [出生]"  ; L2
f1     fact   "前者の説明"  ; L2,L7,L11
r1     req    "出生／%先祖の自由選択との関連"  ; L3
f2     fact   "先祖の自由な選択が出生の差をもたらすとする"  ; L3
v1     eval   "先祖の自由な選択が出生の差をもたらすとする@自由選択の結果を子孫の境遇差の説明として受け入れる"  ; L3
c1     concl  "前者では出生差を先祖の自由選択で説明する〔前者の説明〕"  ; L4
k2     claim  "#出生差への応答の報告 [出生報告]"  ; L7
r2     req    "出生報告／%先祖の自由選択に帰すと書かれている"  ; L8
f3     fact   "原文は出生の差を先祖の自由な選択に帰している"  ; L8
c2     concl  "前者では出生差を先祖の自由選択として説明している〔前者の説明〕"  ; L9
k3     claim  "#出生差の説明の受け入れ [出生受容]"  ; L11
r3     req    "出生受容／$出生報告"  ; L12
r4     req    "出生受容／%説明として足りる"  ; L13
f4     fact   "先祖の選択と子孫の境遇は因果でつながる"  ; L13
v2     eval   "先祖の選択と子孫の境遇は因果でつながる@自由選択の結果を子孫の境遇差の説明として受け入れる"  ; L13
x1     aux    "（L11 AND/2 #1）"  ; L11
c3     concl  "出生差は先祖の自由選択で説明できる〔前者の説明〕"  ; L14

[W]
f1, f2, f3, f4

[rules]
r1: v1 -> r1  ; L3 %先祖の自由選択との関連
r2: -v1 -> -r1  ; L3 %先祖の自由選択との関連（必要条件の否定）
r3: -r1 -> -k1  ; L2 要件の否定による主張 出生 の不成立
r4: f3 -> r2  ; L8 %先祖の自由選択に帰すと書かれている
r5: -f3 -> -r2  ; L8 %先祖の自由選択に帰すと書かれている（必要条件の否定）
r6: -r2 -> -k2  ; L7 要件の否定による主張 出生報告 の不成立
r7: v2 -> r4  ; L13 %説明として足りる
r8: -v2 -> -r4  ; L13 %説明として足りる（必要条件の否定）
r9: r3 & r4 -> x1  ; AND
r10: -r3 -> -x1  ; AND（必要条件の否定）
r11: -r4 -> -x1  ; AND（必要条件の否定）
r12: -x1 -> -k3  ; L11 要件の否定による主張 出生受容 の不成立
r13: k2 -> r3  ; L12 $出生報告 の参照
r14: -k2 -> -r3  ; L12 $出生報告 の参照（必要条件の否定）

[defaults]
e1: f2 : v1, r1 / v1  ; eval L3 評価 @自由選択の結果を子孫の境遇差の説明として受け入れる
出生: f1, r1 : k1, c1 / k1, c1  ; claim L2 主張
出生報告: f1, r2 : k2, c2 / k2, c2  ; claim L7 主張
e2: f4 : v2, r4 / v2  ; eval L13 評価 @自由選択の結果を子孫の境遇差の説明として受け入れる
出生受容: f1, x1 : k3, c3 / k3, c3  ; claim L11 主張

[priority]

[extensions]
; 衝突しうるデフォルト: なし
E1 preferred:
  generating: e1, 出生, 出生報告, e2, 出生受容
  literals: k1, f1, r1, f2, v1, c1, k2, r2, f3, c2, k3, r3, r4, f4, v2, x1, c3

[marks]

[summary]
extensions: 1 (preferred: 1)
skeptical: k1, c1, k2, c2, k3, c3
credulous: k1, c1, k2, c2, k3, c3
; 検証の範囲: 評価 2 個（未審査 2・ok 0・doubtful 0・reject 0。doubtful と未審査の評価も推論を止めない）。最終的な結論 2 個のうち、成り立つもの 2 個、理論の中に対立する命題（否定）がないもの 2 個（これらは、反対の根拠に勝ったのではなく、反対の根拠が書かれていないだけである）。
