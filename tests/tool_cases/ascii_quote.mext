@mext 1
theory: ascii_quote.matcha
source: ascii_quote.matcha sha256=11505326f19b31bd
; MEXT: Matcha EXTension notation。書式は mext の docs/mext.md（スキルでは references/mext.md）を参照。

[ai]
review 'the stadium is open to everyone@a public use' ok ; single quotes: the text has no apostrophe
review "a single developer profits@mainly private" doubtful ; it's arguable (an apostrophe in a note is fine)
fact-kind "the owner's offer was refused" description
; AI（または人）の判断。各行の ; 以降に理由を書く。
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject
;   concern 名 "前提" "前提" …    … 内容の上で一つの争点を共有する前提（感度分析でまとめて外す）
;   distinct "前提" "前提" …      … 内容の上で互いに独立な前提
;   connective "主張のラベルか要件の文言" 明示|読み … 結び方（AND/OR）が原文に明示されているか
;   fact-kind "事実" 記述|仮定|確認済み|著者の主張 … W の事実の種別
;   supplied "前提" …              … 原文になく、書き起こした者が補った前提

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2

[claimed]
E2*: -"the taking is lawful", '"public use"', !'taking／"just compensation"'  ; prediction
;   E1*: "文言", -"文言"   … 検証したい Extension（* は preferred であることも主張）

; ===== generated by mext below this line (do not edit) =====
[atoms]
k1     claim  "#Taking^Fifth Amendment [taking]"  ; L2
f1     fact   "the city"  ; L2,L7
r1     req    'taking／"public use"'  ; L3
f2     fact   "the stadium is open to everyone"  ; L3
v1     eval   "the stadium is open to everyone@a public use"  ; L3
r2     req    'taking／"just compensation"'  ; L4
f3     fact   "the owner's offer was refused"  ; L4
x1     aux    "（L2 AND/2 #1）"  ; L2
c1     concl  "the taking is lawful〔the city〕"  ; L5,L9
k2     claim  "#Objection [objection]"  ; L7
r3     req    'objection／"private benefit"'  ; L8
f4     fact   "a single developer profits"  ; L8
v2     eval   "a single developer profits@mainly private"  ; L8

[W]
f1, f2, f3, f4

[rules]
r1: v1 -> r1  ; L3 "public use"
r2: -v1 -> -r1  ; L3 "public use" (negation of a necessary condition)
r3: f3 -> -r2  ; L4 "just compensation" (ground for failure)
r4: r1 & r2 -> x1  ; AND
r5: -r1 -> -x1  ; AND (negation of a necessary condition)
r6: -r2 -> -x1  ; AND (negation of a necessary condition)
r7: -x1 -> -k1  ; L2 claim taking fails by the negation of its requirement
r8: v2 -> r3  ; L8 "private benefit"
r9: -v2 -> -r3  ; L8 "private benefit" (negation of a necessary condition)
r10: -r3 -> -k2  ; L7 claim objection fails by the negation of its requirement

[defaults]
e1: f2 : v1, r1 / v1  ; eval L3 evaluation @a public use
taking: f1, x1 : k1 / k1  ; claim L2 claim ^Fifth Amendment
taking.不成立: ⊤ : -k1, c1 / c1  ; failure L5 conclusion from the failure of claim taking
e2: f4 : v2, r3 / v2  ; eval L8 evaluation @mainly private (AI: doubtful)
objection: f1, r3 : k2, -c1 / k2, -c1  ; claim L7 claim

[priority]
objection > taking
taking > taking.不成立

[extensions]
; possibly conflicting defaults: taking, taking.不成立, objection
E1:
  generating: e1, taking.不成立, e2
  literals: -k1, f1, r1, f2, v1, -r2, f3, -x1, c1, r3, f4, v2
E2 preferred:
  generating: e1, e2, objection
  literals: -k1, f1, r1, f2, v1, -r2, f3, -x1, -c1, k2, r3, f4, v2

[marks]
! r2     L4 "just compensation"  ; E1:match E2:match

[summary]
extensions: 2 (preferred: 1)
skeptical: -k1, -c1, k2
credulous: -k1, -c1, k2
; scope of verification: 2 evaluations (unreviewed 0, ok 1, doubtful 1, reject 0; doubtful and unreviewed evaluations do not stop inference). 3 facts in W (description 1, unclassified 2; the kinds are AI judgments; assumptions and author claims are candidates in the sensitivity analysis). Of 1 final conclusions, 1 hold and 0 have no opposing proposition (negation) in the theory.
