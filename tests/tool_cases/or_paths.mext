@mext 1
theory: or_paths.matcha
source: or_paths.matcha sha256=b564bcbd1bbafe47
; MEXT: Matcha EXTension notation。書式は mext の docs/mext.md（スキルでは references/mext.md）を参照。

[ai]
; AI（または人）の判断。各行の ; 以降に理由を書く。
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2

[claimed]
;   E1*: "文言", -"文言"   … 検証したい Extension（* は preferred であることも主張）

; ===== ここから下は mext.py が自動生成（手で直さない） =====
[atoms]
k1     claim  "#分業からの禁止 [分業]"  ; L2
f1     fact   "理想化された社会"  ; L2,L5,L8,L11
r1     req    "分業／%協働が損なわれる"  ; L3
f2     fact   "殺し合えば分業が止まる"  ; L3
v1     eval   "殺し合えば分業が止まる@協働が損なわれる理由になる"  ; L3
c1     concl  "分業の観点から殺してはいけない〔理想化された社会〕"  ; L4
k2     claim  "#信用からの禁止 [信用]"  ; L5
r2     req    "信用／%信用の輪から外れる"  ; L6
f3     fact   "殺せば危険視される"  ; L6
v2     eval   "殺せば危険視される@信用を失う理由になる"  ; L6
c2     concl  "信用の観点から殺してはいけない〔理想化された社会〕"  ; L7
k3     claim  "#保険からの禁止 [保険]"  ; L8
r3     req    "保険／%将来の助けを失う"  ; L9
f4     fact   "他者は将来助けてくれるかもしれない"  ; L9
v3     eval   "他者は将来助けてくれるかもしれない@他者を生かす理由になる"  ; L9
c3     concl  "保険の観点から殺してはいけない〔理想化された社会〕"  ; L10
k4     claim  "#禁止 [禁止]"  ; L11
r4     req    "禁止／$分業"  ; L12
r5     req    "禁止／$信用"  ; L12
r6     req    "禁止／$保険"  ; L12
x1     aux    "（L12 OR/3 #1）"  ; L12
c4     concl  "人を殺してはいけない〔理想化された社会〕"  ; L13

[W]
f1, f2, f3, f4

[rules]
r1: v1 -> r1  ; L3 %協働が損なわれる
r2: -v1 -> -r1  ; L3 %協働が損なわれる（必要条件の否定）
r3: -r1 -> -k1  ; L2 要件の否定による主張 分業 の不成立
r4: v2 -> r2  ; L6 %信用の輪から外れる
r5: -v2 -> -r2  ; L6 %信用の輪から外れる（必要条件の否定）
r6: -r2 -> -k2  ; L5 要件の否定による主張 信用 の不成立
r7: v3 -> r3  ; L9 %将来の助けを失う
r8: -v3 -> -r3  ; L9 %将来の助けを失う（必要条件の否定）
r9: -r3 -> -k3  ; L8 要件の否定による主張 保険 の不成立
r10: r4 -> x1  ; OR
r11: r5 -> x1  ; OR
r12: r6 -> x1  ; OR
r13: -r4 & -r5 & -r6 -> -x1  ; OR（すべての選択肢の否定）
r14: -x1 -> -k4  ; L11 要件の否定による主張 禁止 の不成立
r15: k1 -> r4  ; L12 $分業 の参照
r16: -k1 -> -r4  ; L12 $分業 の参照（必要条件の否定）
r17: k2 -> r5  ; L12 $信用 の参照
r18: -k2 -> -r5  ; L12 $信用 の参照（必要条件の否定）
r19: k3 -> r6  ; L12 $保険 の参照
r20: -k3 -> -r6  ; L12 $保険 の参照（必要条件の否定）

[defaults]
e1: f2 : v1, r1 / v1  ; eval L3 評価 @協働が損なわれる理由になる
分業: f1, r1 : k1, c1 / k1, c1  ; claim L2 主張
e2: f3 : v2, r2 / v2  ; eval L6 評価 @信用を失う理由になる
信用: f1, r2 : k2, c2 / k2, c2  ; claim L5 主張
e3: f4 : v3, r3 / v3  ; eval L9 評価 @他者を生かす理由になる
保険: f1, r3 : k3, c3 / k3, c3  ; claim L8 主張
禁止: f1, x1 : k4, c4 / k4, c4  ; claim L11 主張

[priority]

[extensions]
; 衝突しうるデフォルト: なし
E1 preferred:
  generating: e1, 分業, e2, 信用, e3, 保険, 禁止
  literals: k1, f1, r1, f2, v1, c1, k2, r2, f3, v2, c2, k3, r3, f4, v3, c3, k4, r4, r5, r6, x1, c4

[marks]

[summary]
extensions: 1 (preferred: 1)
skeptical: k1, c1, k2, c2, k3, c3, k4, c4
credulous: k1, c1, k2, c2, k3, c3, k4, c4
; 検証の範囲: 評価 3 個（未審査 3・ok 0・doubtful 0・reject 0。doubtful と未審査の評価も推論を止めない）。最終的な結論 1 個のうち、成り立つもの 1 個、理論の中に対立する命題（否定）がないもの 1 個（これらは、反対の根拠に勝ったのではなく、反対の根拠が書かれていないだけである）。
